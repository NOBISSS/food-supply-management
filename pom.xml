<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/>
    </parent>
    <groupId>com.foodsupply</groupId><artifactId>food-supply-management</artifactId><version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>common-library</module><module>auth-service</module><module>beneficiary-service</module>
        <module>food-catalog-service</module><module>procurement-service</module><module>distribution-service</module>
        <module>quality-wastage-service</module><module>inventory-service</module><module>nutrition-programme-service</module>
        <module>reporting-service</module>
    </modules>
    <properties><java.version>21</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
    <dependencyManagement><dependencies>
        <dependency><groupId>com.foodsupply</groupId><artifactId>common-library</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.foodsupply</groupId><artifactId>auth-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.foodsupply</groupId><artifactId>beneficiary-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.foodsupply</groupId><artifactId>food-catalog-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.foodsupply</groupId><artifactId>procurement-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.foodsupply</groupId><artifactId>distribution-service</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.foodsupply</groupId><artifactId>quality-wastage-service</artifactId><version>${project.version}</version></dependency>
    </dependencies></dependencyManagement>
    <build><pluginManagement><plugins><plugin>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
        <configuration><classifier>exec</classifier></configuration>
        <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
    </plugin></plugins></pluginManagement></build>
</project>
